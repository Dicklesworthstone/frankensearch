{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankensearch.dev/schemas/quill-divergence-register-v1.schema.json",
  "title": "Quill Divergence Register ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "register_id",
    "redaction_policy_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "register_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 112,
      "pattern": "^[a-z0-9_-]+$"
    },
    "redaction_policy_version": {
      "const": "quill-divergence-redaction-v1"
    },
    "events": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/register_event"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "bead_id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^bd-[A-Za-z0-9._-]+$"
    },
    "divergence_id": {
      "type": "string",
      "pattern": "^DIV-[0-9]{3}$"
    },
    "prediction_id": {
      "type": "string",
      "pattern": "^PRED-[0-9]{3}$"
    },
    "divergence_class": {
      "type": "string",
      "enum": [
        "tie_order",
        "score_epsilon",
        "rank_mismatch",
        "snippet_mismatch",
        "snippet_window",
        "count_mismatch",
        "document_count_mismatch",
        "glob_expansion_limit",
        "query_canonicalization",
        "oracle_bug",
        "stats_semantics",
        "posting_record_semantics",
        "unicode_edge",
        "oversized_query_token"
      ]
    },
    "event_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "supersedes",
        "recorded_by",
        "recorded_at"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "recorded_by": {
          "$ref": "#/$defs/reviewer"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "revision_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_git_revision",
        "oracle_git_revision",
        "corpus_manifest_sha256",
        "query_manifest_sha256",
        "generator_revision"
      ],
      "properties": {
        "subject_git_revision": {
          "$ref": "#/$defs/git_revision"
        },
        "oracle_git_revision": {
          "$ref": "#/$defs/git_revision"
        },
        "corpus_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "query_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generator_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "fixture_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "fixture_sha256",
        "regression_test",
        "minimized"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "fixture_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "regression_test": {
          "$ref": "#/$defs/bounded_text"
        },
        "minimized": {
          "const": true
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_sha256",
        "marker"
      ],
      "properties": {
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "marker": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^<redacted:[a-z0-9_-]+>$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "divergence_id",
        "class",
        "first_seen_artifact_object_hash",
        "first_seen_artifact_sha256",
        "revisions",
        "fixture",
        "mismatch_signatures",
        "observed_behavior",
        "expected_behavior",
        "root_cause",
        "consumer_impact",
        "diagnostic"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/event_header"
        },
        "divergence_id": {
          "$ref": "#/$defs/divergence_id"
        },
        "class": {
          "$ref": "#/$defs/divergence_class"
        },
        "first_seen_artifact_object_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "first_seen_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "revisions": {
          "$ref": "#/$defs/revision_set"
        },
        "fixture": {
          "$ref": "#/$defs/fixture_evidence"
        },
        "mismatch_signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "observed_behavior": {
          "$ref": "#/$defs/bounded_text"
        },
        "expected_behavior": {
          "$ref": "#/$defs/bounded_text"
        },
        "root_cause": {
          "$ref": "#/$defs/bounded_text"
        },
        "consumer_impact": {
          "$ref": "#/$defs/bounded_text"
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnostic"
        }
      }
    },
    "accepted_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "equivalence_law",
        "rationale",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "kind": {
          "const": "accepted"
        },
        "equivalence_law": {
          "$ref": "#/$defs/bounded_text"
        },
        "rationale": {
          "$ref": "#/$defs/bounded_text"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "fixed_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fixing_commit",
        "regression_test",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "kind": {
          "const": "fixed"
        },
        "fixing_commit": {
          "$ref": "#/$defs/git_revision"
        },
        "regression_test": {
          "$ref": "#/$defs/bounded_text"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "blocking_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bead_id",
        "rationale",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "kind": {
          "const": "blocking"
        },
        "bead_id": {
          "$ref": "#/$defs/bead_id"
        },
        "rationale": {
          "$ref": "#/$defs/bounded_text"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "disposition": {
      "oneOf": [
        {
          "$ref": "#/$defs/accepted_disposition"
        },
        {
          "$ref": "#/$defs/fixed_disposition"
        },
        {
          "$ref": "#/$defs/blocking_disposition"
        }
      ]
    },
    "disposition_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "divergence_id",
        "disposition"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/event_header"
        },
        "divergence_id": {
          "$ref": "#/$defs/divergence_id"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        }
      }
    },
    "declared_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rationale",
        "owner",
        "bead_id"
      ],
      "properties": {
        "kind": {
          "const": "declared"
        },
        "rationale": {
          "$ref": "#/$defs/bounded_text"
        },
        "owner": {
          "$ref": "#/$defs/reviewer"
        },
        "bead_id": {
          "$ref": "#/$defs/bead_id"
        }
      }
    },
    "observed_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "divergence_id",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "kind": {
          "const": "observed"
        },
        "divergence_id": {
          "$ref": "#/$defs/divergence_id"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "retired_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "proof_sha256",
        "rationale",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "kind": {
          "const": "retired"
        },
        "proof_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rationale": {
          "$ref": "#/$defs/bounded_text"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "prediction_state": {
      "oneOf": [
        {
          "$ref": "#/$defs/declared_prediction"
        },
        {
          "$ref": "#/$defs/observed_prediction"
        },
        {
          "$ref": "#/$defs/retired_prediction"
        }
      ]
    },
    "prediction_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "prediction_id",
        "class",
        "state"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/event_header"
        },
        "prediction_id": {
          "$ref": "#/$defs/prediction_id"
        },
        "class": {
          "$ref": "#/$defs/divergence_class"
        },
        "state": {
          "$ref": "#/$defs/prediction_state"
        }
      }
    },
    "observation_wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "event"
      ],
      "properties": {
        "event_type": {
          "const": "observation"
        },
        "event": {
          "$ref": "#/$defs/observation"
        }
      }
    },
    "disposition_wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "event"
      ],
      "properties": {
        "event_type": {
          "const": "disposition"
        },
        "event": {
          "$ref": "#/$defs/disposition_event"
        }
      }
    },
    "prediction_wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "event"
      ],
      "properties": {
        "event_type": {
          "const": "prediction"
        },
        "event": {
          "$ref": "#/$defs/prediction_event"
        }
      }
    },
    "register_event": {
      "oneOf": [
        {
          "$ref": "#/$defs/observation_wrapper"
        },
        {
          "$ref": "#/$defs/disposition_wrapper"
        },
        {
          "$ref": "#/$defs/prediction_wrapper"
        }
      ]
    }
  }
}
