{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankensearch.dev/schemas/fsfs-dsr-release-metadata-v1.schema.json",
  "title": "fsfs DSR Release Build Metadata v1",
  "description": "Build metadata for the DSR default and lite lanes. Structural validation does not verify signatures, artifact bindings, platform qualification or the complete release inventory.",
  "type": "object",
  "required": [
    "tag", "target", "binary", "profile", "source_revision", "rustc",
    "build_timestamp_utc", "semantic_loaders", "embedded_models", "binary_sha256"
  ],
  "properties": {
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "target": { "type": "string", "minLength": 1 },
    "binary": { "const": "fsfs" },
    "profile": { "enum": ["default", "lite"] },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rustc": { "type": "string", "pattern": "^rustc .+" },
    "build_timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
    },
    "semantic_loaders": { "type": "boolean" },
    "embedded_models": { "const": false },
    "binary_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "build_host": { "type": "string", "minLength": 1 },
    "features": { "type": "string" },
    "execution_validation": { "type": "string", "minLength": 1 },
    "version_output": { "type": "string", "minLength": 1 },
    "file_description": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "default" } }, "required": ["profile"] },
      "then": { "properties": { "semantic_loaders": { "const": true } } },
      "else": { "properties": { "semantic_loaders": { "const": false } } }
    }
  ],
  "additionalProperties": true
}
